\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Data and activation collection pipeline. Identical input sequences from FineWeb are processed by both the base and instruction-tuned Gemma 2 2B models, producing residual stream activations that are decomposed into sparse feature vectors by their respective Gemma Scope SAEs.}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:data-activation-collection}{{1}{6}{Data and activation collection pipeline. Identical input sequences from FineWeb are processed by both the base and instruction-tuned Gemma 2 2B models, producing residual stream activations that are decomposed into sparse feature vectors by their respective Gemma Scope SAEs}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Feature comparison pipeline. Sparse feature vectors and decoder matrices from both models are fed into the feature matching procedure, which classifies features into four categories (preserved, modified, base-exclusive, IT-exclusive) before automated labelling and thematic categorisation.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:feature-comparison}{{2}{6}{Feature comparison pipeline. Sparse feature vectors and decoder matrices from both models are fed into the feature matching procedure, which classifies features into four categories (preserved, modified, base-exclusive, IT-exclusive) before automated labelling and thematic categorisation}{figure.2}{}}
